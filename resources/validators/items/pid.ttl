PREFIX : <https://linked.data.gov.au/def/pid/shapes/>
PREFIX lifecycle: <https://linked.data.gov.au/def/lifecycle/>
PREFIX pid: <https://linked.data.gov.au/def/pid/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sg: <https://linked.data.gov.au/def/pid/shapes>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:dates
    a sh:NodeShape ;
    sh:property
        [
            sh:maxCount 1 ;
            sh:message "A PID MUST indicate its creator - a person - with exactly one schema:creator predicate" ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schema:creator ;
        ] ,
        [
            sh:maxCount 1 ;
            sh:message "A PID MUST indicate when it was last modified - a date or year - with exactly one schema:dateModified predicate" ;
            sh:minCount 1 ;
            sh:or (

                [
                    sh:datatype xsd:date ;
                ]

                [
                    sh:datatype xsd:gYear ;
                ]
            ) ;
            sh:path schema:dateModified ;
        ] ,
        [
            sh:maxCount 1 ;
            sh:message "A PID MUST indicate when it was created - a date or year - with exactly one schema:dateCreated predicate" ;
            sh:minCount 1 ;
            sh:or (

                [
                    sh:datatype xsd:date ;
                ]

                [
                    sh:datatype xsd:gYear ;
                ]
            ) ;
            sh:path schema:dateCreated ;
        ] ;
    sh:targetClass pid:Pid ;
.

:redirect-rules
    a sh:NodeShape ;
    rdfs:isDefinedBy sg: ;
    sh:property
        [
            sh:message "Redirect rules must be typed as Apache or NGINX redirect rules." ;
            sh:or (

                [
                    sh:datatype pid:apacheRedirectRules ;
                ]

                [
                    sh:datatype pid:nginxRedirectRules ;
                ]
            ) ;
            sh:path pid:redirectRules ;
        ] ,
        [
            sh:class lifecycle:LifecycleStage ;
            sh:deactivated true ;
            sh:message "A PID must have at least one Lifecycle Stage." ;
            sh:minCount 1 ;
            sh:path lifecycle:hasLifecycleStage ;
        ] ;
    sh:targetClass pid:Pid ;
    schema:description "Validates the lifecycle and redirect-rule properties of PID instances." ;
    schema:name "PID shape" ;
.

sg:
    a sh:ShapesGraph ;
.
